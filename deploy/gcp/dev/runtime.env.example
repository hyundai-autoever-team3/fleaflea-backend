# Reference only. Fill in dev credentials outside Git, with mode 600.
# DEV_ENV_FILE must point to that completed absolute file path.
# APP_IMAGE must be an approved image URI pinned by @sha256: digest.
DEV_ENV_FILE=/etc/fleaflea-dev/runtime.env
APP_IMAGE=
APP_ENV=development
APP_VERSION=
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
EMAIL_VERIFICATION_HASH_SECRET=

# Use the confirmed dev hosts and dev-only bucket, never production values.
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=
SWAGGER_SERVER_URL=
GCS_BUCKET=
GCS_SIGNED_URL_DURATION=1h
S3_BUCKET=unused-dev-gcs
AWS_REGION=ap-northeast-2
AWS_EC2_METADATA_DISABLED=true

# FCM uses the dev VM service account through ADC, without a JSON key.
# Enable only after filling the dev Firebase project and frontend URL and IAM setup.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_WEB_APP_URL=
FCM_WEB_CLICK_LINK_ENABLED=true

# Dev mail is captured inside Mailpit and is not delivered externally.
SMTP_USERNAME=dev@fleaflea.invalid
SMTP_PASSWORD=dev-mailpit-only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

LOG_FORMAT_CONSOLE=ecs
OTEL_JAVAAGENT_ENABLED=false
