# Merge these settings into /etc/fleaflea/fleaflea.env; do not replace that file.
# Enable only after configuring the production VM identity and Firebase IAM.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_WEB_APP_URL=
FCM_WEB_CLICK_LINK_ENABLED=true
# No GOOGLE_APPLICATION_CREDENTIALS and no service-account key mount.
