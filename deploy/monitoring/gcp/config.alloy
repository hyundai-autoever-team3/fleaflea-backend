logging {
  level = "info"
}

// Bind to the app network gateway in observer.env so OTLP stays inside Docker.
otelcol.receiver.otlp "application" {
  http {
    endpoint = coalesce(sys.env("OTLP_HTTP_LISTEN_ADDRESS"), "127.0.0.1:4318")
  }
  output {
    traces = [otelcol.processor.batch.traces.input]
  }
}

otelcol.processor.batch "traces" {
  timeout = "2s"
  send_batch_size = 256
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "127.0.0.1:14317"
    tls {
      insecure = true
    }
  }
}
prometheus.remote_write "local" {
  endpoint {
    url = sys.env("PROMETHEUS_REMOTE_WRITE_URL")
  }
  external_labels = {environment = sys.env("APP_ENV")}
  wal {
    min_keepalive_time = "5m"
    max_keepalive_time = "8h"
  }
}
prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path = "/host/sys"
  rootfs_path = "/host/root"
}
prometheus.exporter.redis "database" {
  redis_addr = "127.0.0.1:6379"
  redis_password = sys.env("REDIS_PASSWORD")
  export_key_values = false
}
discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets
  rule {
    target_label = "job"
    replacement = "fleaflea-node"
  }
  rule {
    target_label = "instance"
    replacement = sys.env("INSTANCE_NAME")
  }
  rule {
    target_label = "service"
    replacement = "node"
  }
}
discovery.relabel "redis" {
  targets = prometheus.exporter.redis.database.targets
  rule {
    target_label = "job"
    replacement = "fleaflea-redis"
  }
  rule {
    target_label = "instance"
    replacement = sys.env("INSTANCE_NAME")
  }
  rule {
    target_label = "service"
    replacement = "redis"
  }
}
prometheus.scrape "host" {
  targets = discovery.relabel.host.output
  job_name = "fleaflea-node"
  scrape_interval = "15s"
  forward_to = [prometheus.remote_write.local.receiver]
}
prometheus.scrape "redis" {
  targets = discovery.relabel.redis.output
  job_name = "fleaflea-redis"
  scrape_interval = "15s"
  forward_to = [prometheus.remote_write.local.receiver]
}
prometheus.scrape "postgres" {
  targets = [{__address__ = "127.0.0.1:19187", instance = sys.env("INSTANCE_NAME"), service = "postgres"}]
  job_name = "fleaflea-postgres"
  scrape_interval = "15s"
  forward_to = [prometheus.remote_write.local.receiver]
}
prometheus.scrape "containers" {
  targets = [{__address__ = "127.0.0.1:18090", instance = sys.env("INSTANCE_NAME"), service = "containers"}]
  job_name = "fleaflea-cadvisor"
  scrape_interval = "30s"
  forward_to = [prometheus.remote_write.local.receiver]
}
discovery.docker "running" {
  host = "tcp://172.29.250.2:2375"
  refresh_interval = "10s"
  filter {
    name = "status"
    values = ["running"]
  }
}
// Discover both deployment slots and scrape the unpublished management port.
discovery.relabel "apps" {
  targets = discovery.docker.running.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex = "fleaflea-(blue|green)"
    action = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex = "app"
    action = "keep"
  }
  rule {
    source_labels = ["__meta_docker_network_ip"]
    regex = ".+"
    action = "keep"
  }
  rule {
    source_labels = ["__meta_docker_network_ip"]
    regex = "(.+)"
    replacement = "$1:8081"
    target_label = "__address__"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex = "fleaflea-(blue|green)"
    replacement = "$1"
    target_label = "slot"
  }
  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label = "instance"
  }
  rule {
    target_label = "service"
    replacement = "fleaflea"
  }
}
prometheus.scrape "apps" {
  targets = discovery.relabel.apps.output
  job_name = "fleaflea-app"
  metrics_path = "/actuator/prometheus"
  scrape_interval = "15s"
  forward_to = [prometheus.remote_write.local.receiver]
}
discovery.relabel "logs" {
  targets = discovery.docker.running.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex = "fleaflea|fleaflea-(blue|green)"
    action = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex = "/(.*)"
    replacement = "$1"
    target_label = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex = "app"
    replacement = "fleaflea"
    target_label = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex = "fleaflea-(blue|green)"
    replacement = "$1"
    target_label = "slot"
  }
  rule {
    target_label = "environment"
    replacement = sys.env("APP_ENV")
  }
  rule {
    target_label = "instance"
    replacement = sys.env("INSTANCE_NAME")
  }
}
loki.source.docker "running" {
  host = "tcp://172.29.250.2:2375"
  targets = discovery.relabel.logs.output
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  endpoint {
    url = sys.env("LOKI_WRITE_URL")
  }
  wal {
    enabled = true
  }
}
