    {
      "id": 5,
      "type": "timeseries",
      "title": "Transaction Rate",
      "description": "초당 커밋 및 롤백 건수입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_xact_commit{job=\"fleaflea-postgres\",environment=~\"$environment\",instance=~\"$instance\",datname=~\"$database\"}[5m]))",
          "legendFormat": "Commits/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(pg_stat_database_xact_rollback{job=\"fleaflea-postgres\",environment=~\"$environment\",instance=~\"$instance\",datname=~\"$database\"}[5m]))",
          "legendFormat": "Rollbacks/s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Connections vs Limit",
      "description": "현재 세션 수와 max_connections 설정을 비교합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(pg_stat_database_numbackends{job=\"fleaflea-postgres\",environment=~\"$environment\",instance=~\"$instance\",datname=~\"$database\"})",
          "legendFormat": "Current {{instance}}",
          "refId": "A"
        },
        {
          "expr": "sum(pg_settings_max_connections{job=\"fleaflea-postgres\",environment=~\"$environment\",instance=~\"$instance\"})",
          "legendFormat": "Connection limit",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cache Hit Ratio",
      "description": "블록 읽기 중 메모리 캐시에서 처리한 비율입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_blks_hit{job=\"fleaflea-postgres\",environment=~\"$environment\",instance=~\"$instance\",datname=~\"$database\"}[5m])) / clamp_min(sum(rate(pg_stat_database_blks_hit{job=\"fleaflea-postgres\",environment=~\"$environment\",instance=~\"$instance\",datname=~\"$database\"}[5m])) + sum(rate(pg_stat_database_blks_read{job=\"fleaflea-postgres\",environment=~\"$environment\",instance=~\"$instance\",datname=~\"$database\"}[5m])), 0.001)",
          "legendFormat": "Hit ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Row Change Rate",
      "description": "선택한 DB의 초당 삽입, 수정, 삭제 행 수입니다.",
      "datasource": {
        "type": "prometheus",
