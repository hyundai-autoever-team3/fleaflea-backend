        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(pg_exporter_last_scrape_error{job=\"fleaflea-postgres\",environment=~\"$environment\",instance=~\"$instance\"})",
