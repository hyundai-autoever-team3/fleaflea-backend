          "refId": "A"
        },
        {
          "expr": "sum(rate(pg_stat_database_tup_updated{job=\"fleaflea-postgres\",environment=~\"$environment\",instance=~\"$instance\",datname=~\"$database\"}[5m]))",
          "legendFormat": "Updates/s",
          "refId": "B"
        },
        {
          "expr": "sum(rate(pg_stat_database_tup_deleted{job=\"fleaflea-postgres\",environment=~\"$environment\",instance=~\"$instance\",datname=~\"$database\"}[5m]))",
          "legendFormat": "Deletes/s",
          "refId": "C"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Locks by Mode",
      "description": "잠금 모드별 현재 개수입니다. 단순 잠금 수만으로 장애를 판단하지 않습니다.",
