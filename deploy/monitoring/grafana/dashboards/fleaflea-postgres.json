  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "PostgreSQL Availability",
      "description": "pg_up 1은 exporter의 DB 연결 성공, 0은 실패입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "min(pg_up{job=\"fleaflea-postgres\",environment=~\"$environment\",instance=~\"$instance\"})",
          "legendFormat": "Connections",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Current Connections",
