      "id": 12,
      "targets": [{"expr": "container_memory_working_set_bytes{job=\"fleaflea-cadvisor\",environment=~\"$environment\",image!=\"\"}", "legendFormat": "{{name}}"}],
      "title": "Container Memory (Production)",
      "type": "timeseries",
      "description": "운영 EC2의 cAdvisor 지표입니다. 로컬에서는 cAdvisor를 실행하지 않아 비어 있습니다."
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 44},
      "id": 13,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "name"},
      "targets": [{"expr": "fleaflea_build_info{service=\"fleaflea\",environment=~\"$environment\"}", "legendFormat": "{{environment}} / {{instance}} / {{version}}"}],
