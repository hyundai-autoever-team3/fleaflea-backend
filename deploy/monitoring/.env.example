# Copy to .env.local and protect it with chmod 600.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password

# Dashboard links in Discord notifications. No trailing slash.
LOCAL_GRAFANA_URL=http://localhost:3000
GCP_GRAFANA_URL=http://localhost:3001

PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=20GB

# Only needed when local/compose.yml is enabled.
LOCAL_DB_USERNAME=postgres
LOCAL_DB_PASSWORD=replace-with-your-local-db-password

# GCP SSH tunnel settings; fill in .env.local.
GCP_PROJECT_ID=your-gcp-project-id
GCP_INSTANCE=your-vm-name
GCP_ZONE=your-vm-zone
