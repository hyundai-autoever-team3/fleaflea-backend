# Copy to .env and protect it with chmod 600.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
GRAFANA_ROOT_URL=https://monitoring.example.com

# For local verification leave both addresses at 127.0.0.1. On the monitoring
# host, bind telemetry ingestion to its private IP and allow ports 9090, 3100,
# and 4317 only from the application EC2 security group.
TELEMETRY_BIND_ADDRESS=127.0.0.1
GRAFANA_BIND_ADDRESS=127.0.0.1

PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=20GB
