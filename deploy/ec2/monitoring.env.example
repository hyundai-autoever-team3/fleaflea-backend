# Install as /etc/fleaflea/monitoring.env with mode 600.
# Use the monitoring server's private address and restrict these ports in its
# security group to the application EC2 security group only.
PROMETHEUS_REMOTE_WRITE_URL=http://10.0.2.20:9090/api/v1/write
LOKI_WRITE_URL=http://10.0.2.20:3100/loki/api/v1/push
TEMPO_OTLP_ENDPOINT=10.0.2.20:4317
APP_ENV=production
INSTANCE_NAME=fleaflea-app-1
OTLP_TRACES_ENABLED=true
DATA_SOURCE_URI=postgres:5432/fleaflea_db?sslmode=disable
DATA_SOURCE_USER=fleaflea_monitor
DATA_SOURCE_PASS=replace-with-a-long-random-password
