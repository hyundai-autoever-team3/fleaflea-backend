# Copy to .env and fill in. .env is git-ignored.
# Gradle loads it into `bootRun` and `test` as real environment variables, so
# both Spring and the AWS SDK (AWS_*) see the values. Variables already set in
# the shell, in CI or on EC2 take precedence over this file.
#
# Use the local PostgreSQL on port 5432 for normal development.
# The separate performance/compose.yml database uses host port 5435.

# Database
DB_URL=jdbc:postgresql://localhost:5432/fleaflea_db
DB_USERNAME=postgres
DB_PASSWORD=password
DB_CONNECTION_TIMEOUT_MS=3000
DDL_AUTO=validate

# Redis (deploy/local/compose.yml)
CHAT_REDIS_ENABLED=false
CHAT_REDIS_CHANNEL_PREFIX=fleaflea:chat
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=local-redis-password
REDIS_HEALTH_ENABLED=true
REDIS_LOCK_WAIT_TIME=5s
# Redisson watchdog timeout; acquisition uses no fixed lease and renews while held.
REDIS_LOCK_LEASE_TIME=60s

# CORS. Separate multiple browser origins with commas.
CORS_ALLOWED_ORIGINS=http://localhost:5175

# Image storage: s3 (default) or gcs. GCP VM uses its attached service account.
IMAGE_STORAGE=s3
# GCS_BUCKET=
# GCS_SIGNED_URL_DURATION=1h

# S3 (local MinIO). Remove the key and endpoint lines to use real AWS S3 with
# an AWS profile instead.
AWS_REGION=ap-northeast-2
S3_BUCKET=fleaflea-local
AWS_ACCESS_KEY_ID=k6local
AWS_SECRET_ACCESS_KEY=k6localpass123
AWS_ENDPOINT_URL_S3=http://127.0.0.1:9010
AWS_EC2_METADATA_DISABLED=true

# JWT. application.yaml has a development default; set your own if needed.
JWT_SECRET=

# FCM: disabled without credentials; use a separate development Firebase project.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_WEB_APP_URL=
# Set false only for localhost receipt testing without an HTTPS click destination.
FCM_WEB_CLICK_LINK_ENABLED=true
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/firebase/service-account.json

# Opt-in real push tests: keep disabled in normal tests and CI.
FCM_INTEGRATION_TEST=false
FCM_LOCAL_INTEGRATION_TEST=false
FCM_NOTIFICATION_FLOW_TEST=false
FCM_TEST_FID=
# Public VAPID key used only by the development browser test page.
FCM_WEB_VAPID_KEY=

# Optional: print SQL to count queries per request (turn off when measuring).
# LOG_LEVEL_HIBERNATE_SQL=DEBUG

# Observability. Start Alloy before enabling trace export in a local run.
# LOG_FORMAT_CONSOLE=ecs
# APP_ENV=local
# APP_VERSION=local
# MANAGEMENT_PORT=8081
# OTEL_SERVICE_NAME=fleaflea
# OTEL_RESOURCE_ATTRIBUTES=service.version=local,deployment.environment.name=local
# OTEL_TRACES_SAMPLER=always_on
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_METRICS_EXPORTER=none
# OTEL_LOGS_EXPORTER=none
# LOG_CORRELATION_PATTERN='[%X{trace_id:-}-%X{span_id:-}] '
# LOGGING_FILE_NAME=build/logs/fleaflea.json
# LOGGING_STRUCTURED_FORMAT_FILE=ecs
